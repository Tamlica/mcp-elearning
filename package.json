{
  "name": "mcp-elearning-ut",
  "version": "0.1.0",
  "description": "MCP server read-only untuk elearning Universitas Terbuka (Moodle Web Services)",
  "type": "module",
  "bin": { "mcp-elearning-ut": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cek": "node --env-file-if-exists=.env dist/cek.js",
    "ambil-token": "node --env-file-if-exists=.env dist/ambil-token.js",
    "test": "npm run build && node --test test/e2e.test.mjs"
  },
  "engines": { "node": ">=18.17" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.3"
  }
}
